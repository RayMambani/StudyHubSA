<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP only to the Android emulator's loopback alias (10.0.2.2),
  so debug builds can talk to `npm run dev` running on your own machine.
  Release builds should only ever call the HTTPS Render/Railway URL, which
  is covered by the base-config default (cleartext disabled).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
