<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvGroupInitial"
        android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/bg_circle_primary"
        android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
        tools:text="D"/>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold"
            tools:text="Data Structures Squad"/>
        <TextView
            android:id="@+id/tvGroupMeta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="11.5sp"
            tools:text="COMS2A · 24 members"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnJoin"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_primary" android:paddingHorizontal="14dp" android:paddingVertical="8dp"
        android:text="@string/action_join" android:textColor="@color/primary" android:textSize="11.5sp" android:textStyle="bold"/>
</LinearLayout>
