<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="13dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="36dp" android:layout_height="36dp"
        android:padding="9dp"
        android:background="@drawable/bg_pill_primary"
        android:src="@drawable/ic_bell"/>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"
            tools:text="New resource uploaded"/>
        <TextView
            android:id="@+id/tvNotifBody"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="12sp"
            tools:text="Lindiwe shared &quot;Ch.4 Linked Lists&quot; in COMS2A"/>
        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="10sp"
            tools:text="2m ago"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDeleteNotif"
        android:layout_width="18dp" android:layout_height="18dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_trash"/>
</LinearLayout>
